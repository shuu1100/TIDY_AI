# TidyAI Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# All defaults are pre-configured for safe, local-only execution.

# Backend Network Binding (Strictly Localhost)
HOST=127.0.0.1
PORT=8765
DEBUG=false

# Local Ollama AI Settings (No external cloud calls)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=15.0

# Database Settings (Local SQLite)
DATABASE_PATH=tidy_ai.db

# Frontend Settings
NEXT_PUBLIC_API_URL=http://127.0.0.1:8765
